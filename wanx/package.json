{
  "name": "wanx-workspace",
  "version": "1.0.3",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev:web": "npm --prefix octop/dashboard run dev",
    "start:client": "npm --prefix apps/personal-client start",
    "test:client": "npm --prefix apps/personal-client test",
    "package:client:mac": "npm --prefix apps/personal-client run package:mac",
    "package:client:windows": "npm --prefix apps/personal-client run package:windows",
    "test:bridge": "uv run --project server/bridge pytest -c server/bridge/pyproject.toml server/bridge/tests -q",
    "build": "node tools/build.mjs",
    "build:app-kit": "node tools/build-app-kit.mjs",
    "test": "npm run test:client",
    "start": "npm run start:client",
    "package:mac": "npm run package:client:mac",
    "package:windows": "npm run package:client:windows",
    "start:mini": "npm --prefix apps/personal-client start",
    "start:studio": "npm --prefix apps/team-client start",
    "test:studio": "npm --prefix apps/builder run check",
    "test:starlink": "npm --prefix apps/starlink test",
    "build:starlink": "npm --prefix apps/starlink run build",
    "test:team-client": "npm --prefix apps/team-client test",
    "package:mini:mac": "npm --prefix apps/personal-client run package:mac",
    "package:studio:mac": "npm --prefix apps/team-client run package:mac",
    "package:mini:windows": "npm --prefix apps/personal-client run package:windows",
    "package:studio:windows": "npm --prefix apps/team-client run package:windows",
    "build:builder-runtime": "node apps/builder/tools/stage-dev-kit.mjs",
    "test:builder-runtime": "node --test tools/tests/builder-runtime.test.mjs"
  }
}
