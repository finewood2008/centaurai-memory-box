+"""Schema 24: owner governance journal; never changes originals or Key identity."""
+from app.db import utc_now
+
+
+def migrate_governance_schema(db):
+    if db.in_transaction or not db.execute('PRAGMA foreign_keys').fetchone()[0]:
+        raise RuntimeError('Governance migration requires foreign keys and no transaction')
+    db.execute('BEGIN IMMEDIATE')
+    try:
+        version = db.execute('SELECT version FROM schema_version').fetchone()[0]
+        if version not in range(23, 31):
+            raise RuntimeError('Governance migration requires schema 23 through 30')
+        db.execute('''CREATE TABLE IF NOT EXISTS knowledge_governance_reviews (
+            id TEXT PRIMARY KEY, workspace_id TEXT NOT NULL,
+            kind TEXT NOT NULL CHECK(kind IN ('entity','relation','candidate')),
+            target_id TEXT NOT NULL, reason TEXT NOT NULL,
+            status TEXT NOT NULL CHECK(status IN ('paused','resolved','pending')),
+            revision INTEGER NOT NULL CHECK(revision>0),
+            binding_json TEXT NOT NULL, source_fingerprint TEXT NOT NULL,
+            actor_id TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL,
+            resolution_json TEXT NOT NULL DEFAULT '{}', UNIQUE(workspace_id,kind,target_id))''')
+        db.execute('CREATE INDEX IF NOT EXISTS idx_governance_paused ON knowledge_governance_reviews(workspace_id,status,kind,target_id)')
+        db.execute('''CREATE TABLE IF NOT EXISTS knowledge_governance_operations (
+            workspace_id TEXT NOT NULL, actor_id TEXT NOT NULL, operation_id TEXT NOT NULL,
+            request_digest TEXT NOT NULL, response_json TEXT NOT NULL, created_at TEXT NOT NULL,
+            PRIMARY KEY(workspace_id,actor_id,operation_id))''')
+        db.execute('''CREATE TABLE IF NOT EXISTS knowledge_governance_proposals (
+            id TEXT PRIMARY KEY, workspace_id TEXT NOT NULL,
+            review_id TEXT NOT NULL REFERENCES knowledge_governance_reviews(id) ON DELETE CASCADE,
+            review_revision INTEGER NOT NULL, source_fingerprint TEXT NOT NULL,
+            status TEXT NOT NULL CHECK(status IN ('generating','ready','insufficient','failed','applied')),
+            revision INTEGER NOT NULL CHECK(revision>0), content_json TEXT NOT NULL,
+            model_json TEXT NOT NULL, actor_id TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)''')
+        db.execute('UPDATE schema_version SET version=24,applied_at=? WHERE version=23', (utc_now(),))
+        db.commit()
+    except BaseException:
+        db.rollback()
+        raise
