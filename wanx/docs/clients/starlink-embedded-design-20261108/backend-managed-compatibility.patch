+    def unflag(self, workspace, actor, *, review_id, expected_revision, operation_id, note=''):
+        digest = _digest(dict(action='unflag',review_id=review_id,expected_revision=expected_revision,note=note))
+        with self.knowledge.document_mutation_lock, self.jobs.transaction() as db:
+            replay = self._replay(db,workspace,actor,operation_id,digest)
+            if replay is not None:
+                return replay
+            row = self._read(db,workspace,review_id)
+            self._revision(row,expected_revision)
+            if row['status'] != 'paused':
+                raise error('该知识当前未暂停', 'REVIEW_CLOSED')
+            self._current(db,row)
+            db.execute('''UPDATE knowledge_governance_reviews SET status='resolved',revision=revision+1,
+                updated_at=?,resolution_json=? WHERE id=?''',
+                (utc_now(),_json({'action':'unflag','actor_id':actor,'note':note}),review_id))
+            self._invalidate(db,workspace)
+            return self._record(db,workspace,actor,operation_id,digest,self._present(self._read(db,workspace,review_id)))
