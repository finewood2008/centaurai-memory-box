+"""Persistent owner governance, bound to current source versions and revisions.
+
+Pausing is an independent delivery barrier, so re-extraction cannot reactivate
+flagged knowledge. Source bodies and old manual decisions are never rewritten.
+"""
+import json
+import uuid
+from copy import deepcopy
+
+from app.db import utc_now
+from app.services.knowledge import KnowledgeError
+from app.services.knowledge_corrections import _digest, _json
+
+
+def error(message, suffix, status=409):
+    return KnowledgeError(message, status, 'WAREHOUSE_GOVERNANCE_' + suffix)
+
+
+class KnowledgeGovernance:
+    def __init__(self, knowledge):
+        self.knowledge, self.jobs = knowledge, knowledge.jobs
+
+    @staticmethod
+    def _read(db, workspace, identifier):
+        row = db.execute('SELECT * FROM knowledge_governance_reviews WHERE workspace_id=? AND id=?',
+                         (workspace, identifier)).fetchone()
+        if row is None:
+            raise error('核对记录不存在或不属于当前数据仓', 'NOT_FOUND', 404)
+        return dict(row)
