+        self.assertEqual(public.status_code,200,public.text);self.assertFalse(public.json()['edges'])
+        resolved=self.write(own,'reviews/'+review['id']+'/resolve',{'action_id':'unflag','reason':'已复核原文无误','expected_revision':1},'resolve')
+        self.assertEqual(resolved.status_code,200,resolved.text)
+        self.assertEqual(resolved.json()['status'],'resolved')
+        summary=self.client.get(endpoint+'summary',headers=self.owner_headers(own));self.assertEqual(summary.json()['paused_count'],0)
+        with self.state.jobs.connect() as db:self.assertEqual([tuple(r) for r in db.execute('SELECT id,token_hash,scopes_json,expires_at,revoked_at FROM xingtu_access_keys')],keys_before)
