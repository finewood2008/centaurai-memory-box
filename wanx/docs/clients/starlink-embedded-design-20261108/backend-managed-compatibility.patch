+"""Synthetic signed-native conversation reads retain current account and warehouse authority."""
+from app.integration.auth import signed_headers
+from tests.test_xingtu_warehouses import WarehouseTests
+
+class ManagedConversationCompatibilityTests(WarehouseTests):
+    def test_managed_conversation_create_list_retry_and_cross_warehouse_rejection(self):
+        own=self.create('合成对话仓');other=self.create('另一个合成仓','other-warehouse')
+        scope=self.scope_for(own,'create-conversation')
+        path='/api/integration/workbench/conversations'
+        headers=signed_headers(self.settings,scope.model_dump())
+        body={'_native_operation_id':'create-conversation','operation_id':'create-conversation','scenario':'material'}
+        first=self.client.post(path,headers=headers,json=body)
+        self.assertEqual(first.status_code,201,first.text)
+        replay=self.client.post(path,headers=headers,json=body)
+        self.assertEqual(replay.status_code,201,replay.text)
+        self.assertEqual(first.json()['resource_id'],replay.json()['resource_id'])
+        listing=self.client.get(path,headers=headers)
+        self.assertEqual(listing.status_code,200,listing.text)
+        self.assertEqual([r['id'] for r in listing.json()['items']],[first.json()['resource_id']])
+        foreign_headers=signed_headers(self.settings,self.scope_for(other).model_dump())
+        self.assertEqual(self.client.get(path,headers=foreign_headers).json()['items'],[])
+        self.assertEqual(self.client.get(path+'/'+first.json()['resource_id'],headers=foreign_headers).status_code,404)
+        self.assertIn(self.client.get(path).status_code,(401,403))
+        forged={**headers,'X-Semantica-Signature':'0'*64}
+        self.assertIn(self.client.get(path,headers=forged).status_code,(401,403))
+        key=self.state.warehouses.create_key(self.scope,own['id'],'合成读凭证',['graph','documents'],1,'key')
+        self.assertIn(self.client.get(path,headers={'Authorization':'Bearer '+key['token']}).status_code,(401,403))
