+    @staticmethod
+    def _revision(row, expected):
+        if type(expected) is not int or row['revision'] != expected:
+            raise error('核对记录已变化，请刷新后重试', 'REVISION_CONFLICT')
+
+    @staticmethod
+    def _binding(db, workspace, kind, identifier):
+        if kind not in ('entity', 'relation'):
+            raise error('仅支持标记实体或关系', 'INVALID_TARGET', 422)
+        table = 'published_entities' if kind == 'entity' else 'published_facts'
+        target = db.execute(f'SELECT * FROM {table} WHERE workspace_id=? AND id=?',
+                            (workspace, identifier)).fetchone()
+        if target is None:
+            raise error('知识不存在或不属于当前数据仓', 'TARGET_NOT_FOUND', 404)
+        condition = 'f.id=?' if kind == 'relation' else '(f.subject_entity_id=? OR f.object_entity_id=?)'
+        ids = [identifier] if kind == 'relation' else [identifier, identifier]
+        evidence = [dict(row) for row in db.execute('''SELECT e.id,e.document_id,e.document_version_id,
+            e.segment_id,e.run_id,e.locator_json,e.excerpt FROM fact_evidence e
+            JOIN published_facts f ON f.id=e.fact_id JOIN knowledge_runs r ON r.id=e.run_id
+            JOIN documents d ON d.id=e.document_id WHERE f.workspace_id=? AND ''' + condition + '''
+            AND e.active=1 AND r.status='published' AND r.workspace_id=d.workspace_id
+            AND d.workspace_id=? AND d.deleted_at IS NULL AND d.active_version_id=e.document_version_id
+            ORDER BY e.id''', [workspace, *ids, workspace])]
+        if kind == 'entity':
+            evidence += [dict(row) for row in db.execute('''SELECT es.entity_id||':'||es.run_id||':'||es.segment_id AS id,
+                d.id AS document_id,r.document_version_id,es.segment_id,es.run_id,
+                s.source_locator_json AS locator_json,s.text AS excerpt FROM published_entity_sources es
+                JOIN knowledge_runs r ON r.id=es.run_id AND r.status='published'
+                JOIN documents d ON d.id=r.document_id AND d.deleted_at IS NULL
+                    AND d.active_version_id=r.document_version_id
+                JOIN content_segments s ON s.id=es.segment_id AND s.version_id=r.document_version_id
+                WHERE es.entity_id=? AND d.workspace_id=? AND r.workspace_id=d.workspace_id
+                  AND r.id=(SELECT k.id FROM knowledge_runs k WHERE k.document_id=d.id
+                    AND k.document_version_id=d.active_version_id AND k.status='published'
+                    ORDER BY k.published_at DESC,k.id DESC LIMIT 1) ORDER BY es.run_id,es.segment_id''',
+                (identifier, workspace))]
+        # Automatic standalone entities have no published_entity_sources in older
+        # databases. Their approved candidate citations are still authoritative.
+        if kind == 'entity' and not evidence:
+            from app.services.knowledge import KnowledgeService
+            namespace = uuid.uuid5(uuid.NAMESPACE_URL, 'semantica:' + workspace)
+            for row in db.execute('''SELECT c.payload_json,c.evidence_json,r.id AS run_id,
+                d.id AS document_id,r.document_version_id FROM fact_candidates c
+                JOIN knowledge_runs r ON r.id=c.run_id AND r.status='published'
+                JOIN documents d ON d.id=r.document_id AND d.deleted_at IS NULL
+                    AND d.active_version_id=r.document_version_id
+                WHERE d.workspace_id=? AND c.kind='entity' AND c.status='published' ORDER BY c.id''', (workspace,)):
+                if KnowledgeService._published_entity_id(namespace, json.loads(row['payload_json'])) != identifier:
+                    continue
+                for source in json.loads(row['evidence_json']):
+                    evidence.append({'id': row['run_id'] + ':' + source['segment_id'],
+                        'document_id': row['document_id'], 'document_version_id': row['document_version_id'],
+                        'segment_id': source['segment_id'], 'run_id': row['run_id'],
+                        'locator_json': _json(source.get('locator', {})), 'excerpt': source.get('excerpt', '')})
+        if not evidence:
+            raise error('该知识已无当前有效来源，请重新读取图谱', 'SOURCE_CHANGED')
+        return {'target': dict(target), 'evidence': sorted(evidence, key=lambda e: e['id'])}
+
+    def _current(self, db, row):
+        binding = self._binding(db, row['workspace_id'], row['kind'], row['target_id'])
+        if _digest(binding) != row['source_fingerprint']:
+            raise error('原始资料或知识版本已变化，请重新标记并核对来源', 'SOURCE_CHANGED')
+        return binding
