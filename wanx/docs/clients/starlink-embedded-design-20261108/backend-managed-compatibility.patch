+"""Private owner-only governance; unified external Keys never acquire write access."""
+from fastapi import APIRouter, Query, Request
+from fastapi.exceptions import RequestValidationError
+from fastapi.responses import JSONResponse
+from fastapi.routing import APIRoute
+from pydantic import BaseModel, ConfigDict, Field
+from typing import Literal
+
+from app.integration.auth import request_scope
+from app.services.knowledge import KnowledgeError
+from app.services.knowledge_governance import KnowledgeGovernance
+
+
+class GovernanceRoute(APIRoute):
+    def get_route_handler(self):
+        original = super().get_route_handler()
+        async def handler(request):
+            grant = request_scope.get()
+            if (grant is None or request.scope.get('starlink_native_owner') != grant.workspace_id
+                    or request.headers.get('origin') or grant.organization_permissions):
+                return JSONResponse({'code':'WAREHOUSE_GOVERNANCE_OWNER_REQUIRED',
+                                     'detail':'请通过万象所属数据仓的星图管理工作台操作'},403)
+            try:
+                grant.require(grant.workspace_id, write=request.method!='GET',
+                              operation_id=grant.operation_id if request.method!='GET' else None)
+                request.app.state.warehouses.assert_scope(grant)
+                response = await original(request)
+            except PermissionError:
+                response = JSONResponse({'code':'WAREHOUSE_GOVERNANCE_PERMISSION_DENIED','detail':'当前账号没有此治理权限'},403)
+            except RequestValidationError:
+                response = JSONResponse({'code':'WAREHOUSE_GOVERNANCE_INVALID_REQUEST','detail':'请求格式无效，请刷新后重试'},422)
+            except KnowledgeError as exc:
+                response = JSONResponse({'code':exc.code,'detail':exc.public_message},exc.status_code)
+            response.headers['Cache-Control']='no-store'
+            response.headers['X-Content-Type-Options']='nosniff'
+            return response
+        return handler
+
+
+router=APIRouter(prefix='/api/governance',route_class=GovernanceRoute)
+Workspace=Query(default='default',min_length=1,max_length=120)
+
+
+class Revision(BaseModel):
+    model_config=ConfigDict(extra='forbid')
+    operation_id:str=Field(min_length=1,max_length=120)
+    expected_revision:int=Field(strict=True,ge=0)
+
+class Flag(Revision):
+    kind:Literal['entity','relation']
+    target_id:str=Field(min_length=1,max_length=128,pattern=r'^[A-Za-z0-9_-]+$')
+    reason:str=Field(default='',max_length=2000)
+
+class Unflag(Revision):
+    review_id:str=Field(min_length=1,max_length=128,pattern=r'^[A-Za-z0-9_-]+$')
+    note:str=Field(default='',max_length=2000)
+
+class Resolve(Revision):
+    action_id:str=Field(min_length=1,max_length=80)
+    reason:str=Field(default='',max_length=2000)
+    note:str=Field(default='',max_length=2000)
+
+class Propose(Revision):
+    review_id:str=Field(min_length=1,max_length=128,pattern=r'^[A-Za-z0-9_-]+$')
+    reason:str=Field(default='',max_length=2000)
+
+class Apply(Revision):
+    confirmed:bool=Field(strict=True)
+
+
+def context(request, workspace, body=None):
+    grant=request_scope.get()
+    if workspace != grant.workspace_id:
+        raise KnowledgeError('不能选择其他数据仓',403,'WAREHOUSE_GOVERNANCE_SCOPE_DENIED')
+    if body is not None and body.operation_id != grant.operation_id:
+        raise KnowledgeError('操作编号与授权不一致',403,'WAREHOUSE_GOVERNANCE_OPERATION_DENIED')
+    return KnowledgeGovernance(request.app.state.knowledge),grant.actor_id
+
+@router.get('/summary')
+def summary(request:Request,workspace_id:str=Workspace):
+    return context(request,workspace_id)[0].summary(workspace_id)
+
+@router.get('/reviews')
+def reviews(request:Request,workspace_id:str=Workspace,limit:int=Query(default=20,ge=1,le=50),offset:int=Query(default=0,ge=0)):
+    return context(request,workspace_id)[0].reviews(workspace_id,limit=limit,offset=offset)
+
+@router.get('/reviews/{review_id}')
+def detail(review_id:str,request:Request,workspace_id:str=Workspace):
+    return context(request,workspace_id)[0].detail(workspace_id,review_id)
+
+@router.post('/flag')
+def flag(body:Flag,request:Request,workspace_id:str=Workspace):
+    service,actor=context(request,workspace_id,body)
+    return service.flag(workspace_id,actor,**body.model_dump())
+
+@router.post('/unflag')
+def unflag(body:Unflag,request:Request,workspace_id:str=Workspace):
+    service,actor=context(request,workspace_id,body)
+    return service.unflag(workspace_id,actor,**body.model_dump())
+
+@router.post('/reviews/{review_id}/resolve')
+def resolve(review_id:str,body:Resolve,request:Request,workspace_id:str=Workspace):
+    service,actor=context(request,workspace_id,body)
+    values=body.model_dump()
+    reason=values.pop("reason")
+    if reason and values["note"] and reason!=values["note"]:
+        raise KnowledgeError("核对理由不一致，请重新操作",422,"WAREHOUSE_GOVERNANCE_INVALID_REQUEST")
+    values["note"]=reason or values["note"]
+    return service.resolve(workspace_id,actor,review_id=review_id,**values)
+
+@router.post('/proposals')
+def propose(body:Propose,request:Request,workspace_id:str=Workspace):
+    service,actor=context(request,workspace_id,body)
+    return service.propose(workspace_id,actor,**body.model_dump())
+
+@router.post('/proposals/{proposal_id}/apply')
+def apply(proposal_id:str,body:Apply,request:Request,workspace_id:str=Workspace):
+    service,actor=context(request,workspace_id,body)
+    return service.apply(workspace_id,actor,proposal_id=proposal_id,**body.model_dump())
