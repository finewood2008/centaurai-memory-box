+    def _present(self, row, *, db=None):
+        binding = json.loads(row['binding_json'])
+        target = binding.get('target', {})
+        name = target.get('canonical_name') or target.get('relation_type') or target.get('payload',{}).get('name') or target.get('payload',{}).get('type') or '知识核对'
+        result = {key: row[key] for key in ('id', 'kind', 'target_id', 'revision', 'status')}
+        result.update(title=({'entity':'实体：','relation':'关系：','candidate':'待核对抽取：'}[row['kind']]) + name,
+            description=row['reason'], source_fingerprint=row['source_fingerprint'],
+            evidence=[{key: source.get(key) for key in ('document_id','document_version_id','segment_id','excerpt')} |
+                {'locator': json.loads(source.get('locator_json') or '{}')}
+                for source in binding.get('evidence', [])[:12]],
+            actions=([{'id':'unflag','label':'确认无误，解除暂停','requires_note':False}] if row['status']=='paused' else
+                [{'id':'reject_candidate','label':'不采用此候选','requires_note':True}] if row['kind']=='candidate' and row['status']=='pending' else
+                [{'id':'keep_separate','label':'确认分别保留','requires_note':True}] if row['kind']=='entity' and row['status']=='pending' else []))
+        if db is not None:
+            proposals = [dict(p) for p in db.execute('''SELECT id,review_id,status,revision,source_fingerprint,content_json,model_json
+                FROM knowledge_governance_proposals WHERE workspace_id=? AND review_id=?
+                ORDER BY created_at DESC LIMIT 5''', (row['workspace_id'], row['id']))]
+            result['proposals'] = [self._present_proposal(p) for p in proposals]
+        return result
+
+    def flag(self, workspace, actor, *, kind, target_id, reason='', expected_revision=0, operation_id):
+        payload = dict(action='flag',kind=kind,target_id=target_id,reason=reason,
+                       expected_revision=expected_revision)
+        digest = _digest(payload)
+        with self.knowledge.document_mutation_lock, self.jobs.transaction() as db:
+            replay = self._replay(db, workspace, actor, operation_id, digest)
+            if replay is not None:
+                return replay
+            old = db.execute('SELECT * FROM knowledge_governance_reviews WHERE workspace_id=? AND kind=? AND target_id=?',
+                             (workspace,kind,target_id)).fetchone()
+            if old:
+                self._revision(old, expected_revision)
+            elif expected_revision != 0:
+                raise error('该知识尚无核对记录，请刷新后重试', 'REVISION_CONFLICT')
+            binding = self._binding(db,workspace,kind,target_id)
+            identifier, revision, now = (old['id'] if old else str(uuid.uuid4())), (old['revision']+1 if old else 1), utc_now()
+            db.execute('''INSERT INTO knowledge_governance_reviews
+                (id,workspace_id,kind,target_id,reason,status,revision,binding_json,source_fingerprint,actor_id,created_at,updated_at)
+                VALUES (?,?,?,?,?,'paused',?,?,?,?,?,?) ON CONFLICT(workspace_id,kind,target_id) DO UPDATE SET
+                  reason=excluded.reason,status='paused',revision=excluded.revision,binding_json=excluded.binding_json,
+                  source_fingerprint=excluded.source_fingerprint,actor_id=excluded.actor_id,
+                  updated_at=excluded.updated_at,resolution_json='{}' ''',
+                (identifier,workspace,kind,target_id,reason or '用户标记为不准确，暂停对外使用',revision,_json(binding),_digest(binding),actor,now,now))
+            self._invalidate(db,workspace)
+            return self._record(db,workspace,actor,operation_id,digest,self._present(self._read(db,workspace,identifier)))
