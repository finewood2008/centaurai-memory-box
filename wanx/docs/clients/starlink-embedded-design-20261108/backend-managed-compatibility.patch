+        key=self.state.warehouses.create_key(self.scope,own['id'],'synthetic-reader',['graph','documents'],1,'key')
+        endpoint='/api/integration/workbench/governance/'
+        body={'kind':'entity','target_id':entity['id'],'reason':'来源待核对','expected_revision':0}
+        with self.state.jobs.connect() as db:
+            keys_before=[tuple(r) for r in db.execute('SELECT id,token_hash,scopes_json,expires_at,revoked_at FROM xingtu_access_keys')]
+        flagged=self.write(own,'flag',body,'flag');self.assertEqual(flagged.status_code,200,flagged.text)
+        review=flagged.json()
+        denied=self.client.post(endpoint+'flag',headers={'Authorization':'Bearer '+key['token']},json=body)
+        self.assertIn(denied.status_code,(401,403))
+        self.assertEqual(self.client.get('/api/governance/summary',headers=self.owner_headers(own)).status_code,403)
+        self.assertEqual(self.client.get(endpoint+'reviews/'+review['id'],headers=self.owner_headers(other)).status_code,404)
+        graph_result=self.client.get('/api/integration/owner/graph',headers=signed_headers(self.settings,self.scope_for(own).model_copy(update={'owner_view':True}).model_dump())).json()
+        self.assertTrue(next(n for n in graph_result['nodes'] if n['id']==entity['id'])['paused'])
