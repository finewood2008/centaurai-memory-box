+"""Portable delivery barriers, never operation receipts, model grants or Keys."""
+import json
+
+from app.services.knowledge import KnowledgeError
+from app.services.knowledge_corrections import _digest, _json
+from app.services.warehouses import WarehouseError
+
+GOVERNANCE_TABLES=('knowledge_governance_reviews',)
+
+
+def validate_governance_archive(data):
+    tables=data['tables']
+    documents={r['id']:r for r in tables['documents']}
+    versions={r['id']:r for r in tables['document_versions']}
+    segments={r['id']:r for r in tables['content_segments']}
+    entities={r['id']:r for r in tables['published_entities']}
+    facts={r['id']:r for r in tables['published_facts']}
+    for row in tables.get(GOVERNANCE_TABLES[0],[]):
+        try:
+            binding=json.loads(row['binding_json']);resolution=json.loads(row['resolution_json'])
+            targets=entities if row['kind']=='entity' else facts if row['kind']=='relation' else {}
+            target=targets.get(row['target_id'])
+            if (target is None or row['workspace_id']!=target['workspace_id']
+                or row['source_fingerprint']!=_digest(binding)
+                or binding['target']['id']!=row['target_id']
+                or binding['target']['workspace_id']!=row['workspace_id']
+                or not isinstance(resolution,dict)
+                or ('barrier' in resolution and resolution['barrier'] is not True)
+                or (resolution.get('action')=='corrected' and resolution.get('barrier') is not True)):
+                raise ValueError()
+            for source in binding['evidence']:
+                document=documents.get(source['document_id']);version=versions.get(source['document_version_id'])
+                segment=segments.get(source['segment_id'])
+                if (not document or not version or not segment or document['workspace_id']!=row['workspace_id']
+                    or version['document_id']!=document['id'] or segment['version_id']!=version['id']
+                    or not isinstance(source['excerpt'],str) or source['excerpt'] not in segment['text']):
+                    raise ValueError()
+        except (ValueError,TypeError,KeyError):
+            raise WarehouseError('治理记录的目标或证据引用无效，保留原数据仓与知识屏障',422,'MIGRATION_GOVERNANCE_REFERENCE_INVALID') from None
+
+
+def portable_review(row):
+    result=dict(row);result['actor_id']='migrated'
+    resolution=json.loads(result['resolution_json'])
+    result['resolution_json']=_json({k:v for k,v in resolution.items() if k in {'action','barrier','run_id','job_id','identity_candidates'}})
+    return result
+
+
+def rebind_imported_reviews(knowledge, db, workspace):
+    from app.services.knowledge_governance import KnowledgeGovernance
+    service=KnowledgeGovernance(knowledge)
+    def normalize(value,field=''):
+        if field.endswith('_json') and isinstance(value,str):
+            return normalize(json.loads(value),field[:-5])
+        if isinstance(value,dict):return {k:normalize(v,k) for k,v in value.items()}
+        if isinstance(value,list):return [normalize(v,field) for v in value]
+        return value
+    def comparable(binding):
+        return {'target':normalize(binding['target']),'evidence':sorted(
+            [normalize({k:v for k,v in e.items() if k!='id'}) for e in binding['evidence']],key=_json)}
+    for row in db.execute('SELECT * FROM knowledge_governance_reviews WHERE workspace_id=?',(workspace,)).fetchall():
+        binding=json.loads(row['binding_json']);fingerprint=_digest(binding)
+        try:
+            current=service._binding(db,workspace,row['kind'],row['target_id'])
+        except KnowledgeError:
+            # A corrected historical target may have no live source. Its barrier
+            # survives; a stale paused review needs an explicit refreshed flag.
+            current=None
+        if current and comparable(current)==comparable(binding):
+            binding=current;fingerprint=_digest(current)
+        db.execute('UPDATE knowledge_governance_reviews SET binding_json=?,source_fingerprint=?,actor_id=? WHERE id=?',
+                   (_json(binding),fingerprint,'migrated',row['id']))
+
+
+def remap_review_nested_json(row, remap):
+    """Bindings contain encoded locators inside encoded JSON; map them too."""
+    def visit(value,field=''):
+        if isinstance(value,dict):return {k:visit(v,k) for k,v in value.items()}
+        if isinstance(value,list):return [visit(v,field) for v in value]
+        if isinstance(value,str) and field.endswith('_json'):
+            return _json(remap(json.loads(value),field[:-5]))
+        return value
+    row['binding_json']=_json(visit(json.loads(row['binding_json'])))
+    row['source_fingerprint']=_digest(json.loads(row['binding_json']))
+    return row
