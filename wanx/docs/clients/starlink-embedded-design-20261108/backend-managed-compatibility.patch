+    @staticmethod
+    def _invalidate(db, workspace):
+        now = utc_now()
+        db.execute('''INSERT INTO delivery_revisions(workspace_id,revision) VALUES (?,1)
+            ON CONFLICT(workspace_id) DO UPDATE SET revision=revision+1''', (workspace,))
+        db.execute('''UPDATE reasoning_preparations SET invalidated_at=?,invalidation_code='knowledge_governance_changed',
+            dependencies_json='[]',document_ids_json='[]',input_check_json='{}'
+            WHERE workspace_id=? AND invalidation_code IS NULL''', (now, workspace))
+        for table in ('reasoning_preparation_skills', 'reasoning_preparation_documents'):
+            db.execute(f'DELETE FROM {table} WHERE preparation_id IN (SELECT id FROM reasoning_preparations WHERE workspace_id=?)', (workspace,))
+
+    @staticmethod
+    def _replay(db, workspace, actor, operation, digest):
+        row = db.execute('''SELECT * FROM knowledge_governance_operations
+            WHERE workspace_id=? AND actor_id=? AND operation_id=?''', (workspace, actor, operation)).fetchone()
+        if row:
+            if row['request_digest'] != digest:
+                raise error('此操作编号已用于不同请求，请重新操作', 'OPERATION_CONFLICT')
+            return json.loads(row['response_json'])
+
+    @staticmethod
+    def _record(db, workspace, actor, operation, digest, response):
+        db.execute('INSERT INTO knowledge_governance_operations VALUES (?,?,?,?,?,?)',
+                   (workspace, actor, operation, digest, _json(response), utc_now()))
+        return response
