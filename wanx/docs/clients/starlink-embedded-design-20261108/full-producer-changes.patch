+import {cp,mkdir,readFile,writeFile} from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';
+const destination=fileURLToPath(new URL('../ui/compact-assets/',import.meta.url));
+let source=process.argv[2]||process.env.WANX_CLIENT_SOURCE;
+if(!source){try{source=JSON.parse(await readFile(fileURLToPath(new URL('../.compact-source.json',import.meta.url)),'utf8')).source}catch{throw Error('构建精简版需要万象客户端生成资源目录：node tools/build-compact.mjs <personal-client/local-ui/renderer>')}}
+source=path.resolve(source);await mkdir(destination,{recursive:true});const files=['data-view.js','data.css','styles.css','personal-layout.css','material-theme.css'],manifest={origin:'WANX canonical client UI',files:{}};
+await writeFile(fileURLToPath(new URL('../.compact-source.json',import.meta.url)),JSON.stringify({source})+'\n');
+for(const name of files){const data=await readFile(path.join(source,name));await writeFile(path.join(destination,name),data);manifest.files[name]=createHash('sha256').update(data).digest('hex')}
+for(const name of ['section-icons-v2/starlink.png','material-v1/starlink.png']){const target=path.join(destination,'assets',name);await mkdir(path.dirname(target),{recursive:true});await cp(path.join(source,'assets',name),target)}
+await writeFile(path.join(destination,'source-manifest.json'),JSON.stringify(manifest,null,2)+'\n');console.log('Generated shared STARLINK compact UI assets');
diff --git a/desktop/tests/compact-mode.test.mjs b/desktop/tests/compact-mode.test.mjs
new file mode 100644
index 0000000..dc7bbd1
--- /dev/null
+++ b/desktop/tests/compact-mode.test.mjs
@@ -0,0 +1,27 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import vm from 'node:vm';
+
+function adapter(){
+ const requests=[];
+ const root={addEventListener(){}};
+ const sandbox={document:{querySelector:()=>root,querySelectorAll:()=>[]},window:{semantica:{subscribe(){},call:async(name,input)=>{requests.push({name,input});return {ok:true,value:{version_id:'version',text:'合成正文'}}}}},URLSearchParams};
+ vm.runInNewContext(readFileSync(new URL('../ui/compact-mode.js',import.meta.url),'utf8')+'\n;globalThis.testRequest=request;',sandbox);
+ return {request:sandbox.testRequest,requests};
+}
+test('compact preview preserves version and lets the native backend bound short-document reads',async()=>{
+ const {request,requests}=adapter();
+ for(const input of [{start:37},{start:37,end:51}]){
+  const value=await request('data.document-text',{warehouseId:'warehouse',id:'document',versionId:'version',...input});
+  assert.equal(value.version_id,'version');
+  const {name,input:target}=requests.at(-1),url=new URL(target.url,'http://fixture');
+  assert.equal(name,'workbench-request');assert.equal(target.warehouseId,'warehouse');
+  assert.equal(url.pathname,'/api/documents/document/text');
+  assert.equal(url.searchParams.get('version_id'),'version');assert.equal(url.searchParams.get('start'),'37');
+  assert.equal(url.searchParams.get('end'),input.end===undefined?null:String(input.end));
+ }
+});
+test('compact adapter does not expose arbitrary native actions',async()=>{
+ const {request,requests}=adapter();await assert.rejects(request('data.arbitrary',{url:'http://other'}),/COMPACT_ACTION_DENIED/);assert.equal(requests.length,0);
+});
