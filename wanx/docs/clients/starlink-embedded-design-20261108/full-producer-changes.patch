@@ -0,0 +1,52 @@
+const root=document.querySelector('#starlink-compact-root');
+const buttons=[...document.querySelectorAll('[data-starlink-mode]')];
+let view=null,ready=false,active=false,scope=null,identity=null,load=0;
+async function call(name,input={}){
+ const result=await window.semantica.call(name,input);
+ if(!['workbench-request','create-warehouse','reprocess-models'].includes(name))return result;
+ if(!result?.ok)throw Object.assign(new Error(result?.code||'COMPACT_RESPONSE_INVALID'),{code:result?.code,publicMessage:result?.message});
+ return result.value;
+}
+const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+function render(){if(active&&view){root.innerHTML=view.render();root.querySelector('[data-data-action="assistant-access"]')?.remove()}}
+function scopeKey(v){return JSON.stringify([v.identity?.user?.id,v.identity?.boxId,v.identity?.dataScope])}
+async function request(name,input={}){
+ const action=name.replace(/^data\./,'');const warehouseId=input.warehouseId||view?.currentWarehouse();const target={...input,warehouseId};
+ if(action==='open-starlink'){await setMode('full',input);return {opened:true}}
+ if(action==='authorization-summary'){const keys=await call('keys',{warehouseId});let active_count=0;for(const k of keys.items||[])if(!k.revoked_at&&k.expires_at>Date.now()/1000)active_count++;return {active_count}}
+ if(action==='document-text')return call('workbench-request',{warehouseId,url:'/api/documents/'+encodeURIComponent(input.id)+'/text?'+new URLSearchParams({version_id:input.versionId,start:String(input.start||0),...(input.end!==undefined?{end:String(input.end)}:{})})});
+ if(action.startsWith('governance-')){
+  const paths={'governance-summary':'/summary','governance-reviews':'/reviews?'+new URLSearchParams({offset:String(input.offset||0),limit:String(input.limit||20)}),'governance-detail':'/reviews/'+encodeURIComponent(input.reviewId),'governance-flag':'/flag','governance-unflag':'/unflag','governance-propose':'/proposals','governance-resolve':'/reviews/'+encodeURIComponent(input.reviewId)+'/resolve','governance-apply':'/proposals/'+encodeURIComponent(input.proposalId)+'/apply'};
+  if(!paths[action])throw Error('COMPACT_ACTION_DENIED');const reading=['governance-summary','governance-reviews','governance-detail'].includes(action);const body={operation_id:input.operationId,expected_revision:input.expectedRevision,review_id:input.reviewId,action_id:input.actionId,reason:input.reason,kind:input.kind,target_id:input.targetId,confirmed:input.confirmed};
+  return call('workbench-request',{warehouseId,url:'/api/governance'+paths[action],method:reading?'GET':'POST',...(!reading?{body:JSON.stringify(body)}:{})});
+ }
+ if(!['warehouses','warehouse','create-warehouse','select-warehouse','documents','document','correct','jobs','graph','retrieval','search','retry-job','build-index','processing','reprocess-models','select-files','select-space-files','space-list','release-files','upload'].includes(action))throw Error('COMPACT_ACTION_DENIED');
+ if(['create-warehouse','retry-job','build-index'].includes(action))target.operationId??=crypto.randomUUID();
+ const before=load,result=await call(action,target);if(before!==load)throw Error('HOST_SESSION_EXPIRED');return result;
+}
+async function initialize(){
+ const seq=++load;root.innerHTML='<p class="starlink-mode-notice">正在读取万象账号与数据仓…</p>';
+ const v=await call('initialize');if(seq!==load)return;
+ if(scope!==scopeKey(v)){view?.suspend();view=null;scope=scopeKey(v)}identity=v.identity;
+ view??=window.createTeamDataView({edition:identity.dataScope==='team'?'team':'personal',request,changed:render});
+ view.sync({canLaunchApplications:true,account:{accountId:String(identity.user.id)},activeDeviceId:identity.boxId},identity.dataScope!=='team'||v.status?.native_owner_management===true);
+ await view.refresh();const selected=window.starlinkCompactHost?.context().warehouseId;if(selected&&v.warehouses.items.some(w=>w.id===selected))await view.action('select',{id:selected,tab:'graph'});ready=true;render();
+}
+window.starlinkCompactCanLeave=()=>!view?.hasMaterialDrafts();
+async function setMode(mode,target){
+ if(mode==='full'){
+  if(!window.starlinkCompactCanLeave()){alert('精简版中有未完成的正文编辑，请先保存或取消。');return}
+  active=false;root.hidden=true;document.querySelector('#app').hidden=false;for(const link of document.querySelectorAll('[data-compact-style]'))link.media='not all';view?.suspend();
+  if(target?.warehouseId||view?.currentWarehouse())await window.starlinkCompactHost?.select(target?.warehouseId||view.currentWarehouse(),target?.view||'graph');
+ }else{
+  if(window.starlinkCompactHost?.canLeave()===false){alert('完整版中有未完成的编辑，请先保存或取消。');return}
+  active=true;document.querySelector('#app').hidden=true;root.hidden=false;for(const link of document.querySelectorAll('[data-compact-style]'))link.media='all';await initialize();
+ }
+ document.body.dataset.starlinkMode=mode;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.starlinkMode===mode)));
+}
+buttons.forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.starlinkMode).catch(e=>{root.innerHTML='<p class="starlink-mode-notice">'+esc(e.publicMessage||'连接未就绪，请重试或返回完整版。')+'</p>'})));
+root.addEventListener('click',e=>{const b=e.target.closest('[data-data-action]');if(b){e.preventDefault();void view?.action(b.dataset.dataAction,b.dataset)}});
+root.addEventListener('submit',e=>{const f=e.target.closest('[data-data-form]');if(f){e.preventDefault();void view?.submit(f.dataset.dataForm,new FormData(f))}});
+root.addEventListener('input',e=>{if(e.target.name)view?.input(e.target.name,e.target.value)});
+window.semantica.subscribe(e=>{if(e.type==='invalidated'){load++;ready=false;view?.suspend();root.innerHTML='<p class="starlink-mode-notice">账号或设备连接已变化，请重新连接。</p>'}});
+window.starlinkRestoreFullMode=()=>{document.body.dataset.starlinkMode='full';active=false;root.hidden=true;document.querySelector('#app').hidden=false;view?.suspend();for(const link of document.querySelectorAll('[data-compact-style]'))link.media='not all';buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.starlinkMode==='full')))};
