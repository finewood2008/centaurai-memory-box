{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wanx:expert-app:v1:dependency-lock",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "expert-template"
          },
          "resourceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^0\\.0\\.0\\+sha\\.[a-f0-9]{12}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "resourceId",
          "version",
          "digest"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "dependencies"
  ]
}
