{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wanx:expert-app:v1:client",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "applicationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "artifactHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "name",
        "entry",
        "capabilities",
        "collections"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "entry": {
          "const": "src/app.js"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "foundation",
              "data"
            ]
          },
          "contains": {
            "const": "foundation"
          }
        },
        "collections": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_-]{0,49}$": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 50,
              "additionalProperties": false,
              "patternProperties": {
                "^[a-zA-Z][a-zA-Z0-9_]{0,49}$": {
                  "enum": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "collections": {
                "minProperties": 1
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "data"
                }
              }
            }
          }
        }
      ]
    },
    "bundle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "css": {
      "type": "string",
      "maxLength": 1048576
    },
    "runtimeNamespace": {
      "enum": ["workshop", "studio"]
    }
  },
  "required": [
    "applicationId",
    "name",
    "version",
    "artifactHash",
    "manifest",
    "bundle",
    "css",
    "runtimeNamespace"
  ]
}
