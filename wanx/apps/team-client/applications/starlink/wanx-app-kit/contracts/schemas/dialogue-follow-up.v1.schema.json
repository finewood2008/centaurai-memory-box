{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wanx-dialogue-follow-up/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "prompt"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{16,80}$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    }
  }
}
