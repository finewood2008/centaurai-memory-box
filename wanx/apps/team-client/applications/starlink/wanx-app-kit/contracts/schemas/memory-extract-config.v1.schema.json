{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wanx-memory-extract-config/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_enabled",
    "extract_on_session_end",
    "extract_trigger_mode",
    "extract_idle_seconds",
    "extract_interval_seconds",
    "aux_model"
  ],
  "properties": {
    "memory_enabled": {
      "type": "boolean"
    },
    "extract_on_session_end": {
      "type": "boolean"
    },
    "extract_trigger_mode": {
      "enum": [
        "idle",
        "interval"
      ]
    },
    "extract_idle_seconds": {
      "type": "number",
      "minimum": 60,
      "maximum": 604800
    },
    "extract_interval_seconds": {
      "type": "number",
      "minimum": 300,
      "maximum": 604800
    },
    "aux_model": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
