{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wanx-dialogue-session/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "revision",
    "groups"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "parent_answer",
          "answers"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "parent_answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "generation_id",
                "model",
                "name",
                "text",
                "status",
                "error",
                "usage",
                "elapsed_ms",
                "accounting"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "generation_id": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "queued",
                    "running",
                    "completed",
                    "stopped",
                    "failed",
                    "interrupted"
                  ]
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "usage": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "elapsed_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "accounting": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
