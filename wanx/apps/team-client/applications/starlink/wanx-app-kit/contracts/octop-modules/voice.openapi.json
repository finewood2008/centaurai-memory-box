            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Name",
            "description": "Configured transcription service display name; no credentials or endpoint."
          },
          "provider_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Kind",
            "description": "Native service type, for example openai, tencent, or mimo."
          },
