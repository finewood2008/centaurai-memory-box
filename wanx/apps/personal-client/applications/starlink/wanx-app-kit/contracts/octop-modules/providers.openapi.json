  "components": {
    "schemas": {
      "ActiveModelBody": {
        "properties": {
          "provider_name": {
            "type": "string",
            "title": "Provider Name"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "provider_name",
          "model"
        ],
        "title": "ActiveModelBody"
      },
      "ApplicationDefaultStatus": {
        "properties": {
          "provider_name": {
            "type": "string",
            "pattern": "^admin-managed-[a-z][a-z0-9-]{0,63}$",
            "title": "Provider Name"
          },
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
            "title": "Model"
          },
          "model_ref": {
            "type": "string",
            "title": "Model Ref"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provider_name",
          "model",
          "model_ref",
          "available"
        ],
        "title": "ApplicationDefaultStatus"
      },
      "ApplicationDefaultsStatus": {
        "properties": {
          "managed": {
            "type": "boolean",
            "title": "Managed"
          },
          "revision": {
            "type": "string",
            "title": "Revision"
          },
          "defaults": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ApplicationDefaultStatus"
            },
            "propertyNames": {
              "enum": [
                "starlink",
                "dialogue",
                "kaiwu"
              ]
            },
            "type": "object",
            "title": "Defaults"
          }
        },
        "type": "object",
        "required": [
          "managed",
          "revision",
          "defaults"
        ],
        "title": "ApplicationDefaultsStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MediaGenerationSettingsBody": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/MediaProviderBody"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Providers"
          },
          "default_image_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Image Provider"
          },
          "default_video_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Video Provider"
          }
        },
        "type": "object",
        "title": "MediaGenerationSettingsBody"
      },
      "MediaGenerationSettingsResponse": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/MediaProviderResponse"
            },
            "type": "array",
            "title": "Providers"
          },
          "default_image_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Image Provider"
          },
          "default_video_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Video Provider"
          },
          "configured": {
            "type": "boolean",
            "title": "Configured"
          }
        },
        "type": "object",
        "required": [
          "enabled",
          "providers",
          "default_image_provider",
          "default_video_provider",
          "configured"
        ],
        "title": "MediaGenerationSettingsResponse"
      },
      "MediaGenerationTestBody": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "credentials",
              "image",
              "video"
            ],
            "title": "Kind",
            "default": "credentials"
          },
          "provider": {
            "$ref": "#/components/schemas/MediaProviderBody"
          }
        },
        "type": "object",
        "required": [
          "provider"
        ],
        "title": "MediaGenerationTestBody"
      },
      "MediaGenerationTestResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
