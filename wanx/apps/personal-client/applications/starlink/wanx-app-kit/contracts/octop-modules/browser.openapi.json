    "/api/browser/sessions/{session_id}/handoff": {
      "post": {
        "tags": [
          "browser"
        ],
        "summary": "Handoff",
        "description": "Switch control of a browser session between the agent and the user.\n\nManaged sessions enforce control in the input and tool paths. Taking\nmanual control first blocks queued tools, cancels the active turn, then\ndrains in-flight browser work before reporting readiness. Ownership is\nretained in memory across dashboard reloads and stream reconnections.",
        "operationId": "handoff_api_browser_sessions__session_id__handoff_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
