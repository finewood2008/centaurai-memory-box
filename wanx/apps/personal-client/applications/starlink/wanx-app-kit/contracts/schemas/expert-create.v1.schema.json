{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wanx-expert-create/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "providers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "default_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "color": {
      "type": [
        "string",
        "null"
      ]
    },
    "welcome_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "enable_trajectory": {
      "type": "boolean"
    },
    "skill_package_ids": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "knowledge_base_ids": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "mcp_servers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "backend": {
      "type": [
        "object",
        "null"
      ]
    },
    "max_iters": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "max_input_length": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1000
    },
    "temperature": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 2
    },
    "top_p": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "max_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "file_overrides": {
      "type": [
        "array",
        "null"
      ]
    },
    "omit_files": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "quick_prompts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "prompt",
          "color",
          "icon_name"
        ],
        "properties": {
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh",
              "en"
            ],
            "properties": {
              "zh": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh",
              "en"
            ],
            "properties": {
              "zh": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "prompt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh",
              "en"
            ],
            "properties": {
              "zh": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "color": {
            "type": "string"
          },
          "icon_name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
