{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wanx-dialogue-quota/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "remaining",
    "pending",
    "billing"
  ],
  "properties": {
    "source": {
      "enum": [
        "wanx_pool",
        "platform_gateway"
      ]
    },
    "remaining": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "pending": {
      "type": "integer",
      "minimum": 0
    },
    "billing": {
      "type": "string"
    }
  }
}
