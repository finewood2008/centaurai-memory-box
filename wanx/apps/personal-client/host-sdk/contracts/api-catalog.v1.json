      "routes": [
        {
          "method": "GET",
          "path": "/api/dialogue/quota",
          "operation": "readDialogueQuota",
          "sideEffect": "none",
          "responseSchema": "schemas/dialogue-quota.v1.schema.json",
          "permission": "dialogue.sessions.read"
        },
        {
          "method": "GET",
          "path": "/api/dialogue/sessions",
          "operation": "listDialogueSessions",
          "sideEffect": "none",
          "responseSchema": "schemas/dialogue-session-list.v1.schema.json",
          "permission": "dialogue.sessions.read"
        },
        {
          "method": "POST",
          "path": "/api/dialogue/sessions",
          "operation": "createDialogueSession",
          "sideEffect": "creates-session-and-dispatches-models",
          "requestSchema": "schemas/dialogue-question.v1.schema.json",
          "responseSchema": "schemas/dialogue-session.v1.schema.json",
          "permission": "dialogue.sessions.create",
          "idempotency": "request_id + payload fingerprint; same request_id with different payload is IDEMPOTENCY_CONFLICT"
        },
        {
          "method": "GET",
          "path": "/api/dialogue/sessions/{session_id}",
          "operation": "readDialogueSession",
          "sideEffect": "none",
          "responseSchema": "schemas/dialogue-session.v1.schema.json",
          "permission": "dialogue.sessions.read"
        },
        {
          "method": "DELETE",
          "path": "/api/dialogue/sessions/{session_id}",
          "operation": "deleteDialogueSession",
          "sideEffect": "deletes-session-history-and-stops-answers",
          "responseSchemaStatus": "none",
          "permission": "dialogue.sessions.mutate",
          "idempotency": "repeat after confirmed deletion is not replayable; treat 404 as terminal"
        },
        {
          "method": "POST",
          "path": "/api/dialogue/sessions/{session_id}/groups/{group_id}/answers",
          "operation": "addDialogueModels",
          "sideEffect": "dispatches-models",
          "requestSchema": "schemas/dialogue-add-models.v1.schema.json",
          "responseSchema": "schemas/dialogue-session.v1.schema.json",
          "permission": "dialogue.sessions.mutate",
          "idempotency": "request_id + payload fingerprint"
        },
        {
          "method": "POST",
          "path": "/api/dialogue/sessions/{session_id}/answers/{answer_id}/continue",
          "operation": "continueDialogueAnswer",
          "sideEffect": "creates-branch-and-dispatches-model",
          "requestSchema": "schemas/dialogue-follow-up.v1.schema.json",
          "responseSchema": "schemas/dialogue-session.v1.schema.json",
          "permission": "dialogue.sessions.mutate",
          "idempotency": "request_id + payload fingerprint"
        },
        {
          "method": "POST",
          "path": "/api/dialogue/sessions/{session_id}/answers/{answer_id}/retry",
          "operation": "retryDialogueAnswer",
          "sideEffect": "dispatches-model",
          "requestSchema": "schemas/dialogue-operation.v1.schema.json",
          "responseSchema": "schemas/dialogue-session.v1.schema.json",
          "permission": "dialogue.sessions.mutate",
          "idempotency": "request_id + payload fingerprint"
        },
        {
          "method": "POST",
          "path": "/api/dialogue/sessions/{session_id}/answers/{answer_id}/stop",
          "operation": "stopDialogueAnswer",
          "sideEffect": "stops-answer",
          "responseSchema": "schemas/dialogue-session.v1.schema.json",
          "permission": "dialogue.sessions.mutate",
          "idempotency": "safe repeat after status read"
        },
        {
          "method": "GET",
          "path": "/api/dialogue/sessions/{session_id}/events",
          "operation": "streamDialogueSnapshots",
          "sideEffect": "none",
          "responseSchema": "schemas/dialogue-event.v1.schema.json",
          "permission": "dialogue.sessions.stream",
          "reconnect": "reconnect by GET; stream emits revisioned snapshots and terminates when no answer is active"
        }
      ],
      "missingBeforeOpen": [
        "真实盒子验收",
        "版本兼容登记"
      ]
    },
