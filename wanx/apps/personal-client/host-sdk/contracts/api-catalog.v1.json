{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "wanx-business-api-catalog/1",
  "version": "0.3.0",
  "purpose": "整理现有 WANX 运行时入口，区分可形成合同的 API、合同缺口和禁止暴露的内部路由。",
  "statuses": {
    "open": "已有版本化路径、参数、响应、错误、权限和验收证据，可进入应用合同。",
    "contract-only": "已有实现或稳定入口，但 App Kit 仍缺完整公共合同；应用不得按路径猜测调用。",
    "inventory-only": "仅用于盘点现有路由，不代表应用权限。",
    "forbidden": "明确不进入应用 API；通常包含管理写入、凭据或内部路由。",
    "ready-for-acceptance": "公共请求/响应、错误、权限和兼容规则已写入 App Kit，但仍需真实盒子验收和版本登记后才能标记为 open。"
  },
  "requiredContract": [
    "stable-path-and-method",
    "request-parameters-and-extra-field-policy",
    "response-types-and-json-schema",
    "stable-error-codes-and-http-mapping",
    "account-user-box-application-resource-scope",
    "idempotency-retry-and-non-replay-rules",
    "session-expiry-box-switch-and-revocation",
    "compatibility-version-and-acceptance-evidence"
  ],
  "surfaces": [
    {
      "id": "agent.channels",
      "status": "ready-for-acceptance",
      "contractFiles": [
        "octop-modules/channels.openapi.json",
        "octop-modules/loops.openapi.json"
      ],
      "requiredBeforeOpen": [
        "real-box-acceptance",
        "session-revocation-evidence"
      ],
      "title": "当前助手的消息渠道",
      "scope": "当前用户、盒子、应用部署绑定与所选平台",
      "transport": "Host SDK / trusted configuration component",
      "permission": "Host session and agent channel management authority"
    },
    {
