{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wanx-expert-app-context/1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scopeId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "applicationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "baseApplicationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "slotApplicationId": {
      "type": "string",
      "pattern": "^ai\\.wanx\\.selfmade\\.[a-f0-9]{32}$"
    },
    "boxId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environment": {
      "enum": [
        "dev",
        "prod"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "artifactHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packageSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimeNamespace": {
      "const": "studio"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "wanx.expert-app.v1"
        },
        "version": {
          "const": "1.0.0"
        },
        "features": {
          "type": "array",
          "items": {
            "enum": [
              "context",
              "expert",
              "data"
            ]
          },
          "uniqueItems": true,
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "id",
        "version",
        "features"
      ]
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "productId": {
          "const": "wanx"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "ready"
            }
          },
          "required": [
            "status"
          ]
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "const": "wanx.expert-app.v1"
              },
              "version": {
                "const": "1.0.0"
              },
              "features": {
                "type": "array",
                "items": {
                  "enum": [
                    "context",
                    "expert",
                    "data"
                  ]
                },
                "uniqueItems": true,
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "id",
              "version",
              "features"
            ]
          },
          "minItems": 1,
          "maxItems": 1
        },
        "resources": {
          "const": []
        },
        "bindings": {
          "const": []
        }
      },
      "required": [
        "schemaVersion",
        "productId",
        "deviceId",
        "observedAt",
        "authorization",
        "contracts",
        "resources",
        "bindings"
      ]
    },
    "dashboardPanels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId",
        "modules"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "modules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channels"
          ],
          "properties": {
            "channels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "weixin",
                  "qq",
                  "wecom",
                  "feishu",
                  "yuanbao",
                  "dingtalk",
                  "telegram",
                  "discord",
                  "xiaoyi",
                  "mqtt"
                ]
              }
            },
            "ownerVerification": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "weixin",
                  "qq",
                  "wecom",
                  "feishu",
                  "yuanbao",
                  "dingtalk",
                  "telegram",
                  "discord",
                  "xiaoyi",
                  "mqtt"
                ]
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "scopeId",
    "applicationId",
    "baseApplicationId",
    "slotApplicationId",
    "boxId",
    "environment",
    "generation",
    "operationId",
    "artifactHash",
    "packageSha256",
    "runtimeNamespace",
    "contract",
    "backend"
  ]
}
