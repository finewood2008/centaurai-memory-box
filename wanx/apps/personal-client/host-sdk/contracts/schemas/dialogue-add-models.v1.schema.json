{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wanx-dialogue-add-models/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "models"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{16,80}$"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
