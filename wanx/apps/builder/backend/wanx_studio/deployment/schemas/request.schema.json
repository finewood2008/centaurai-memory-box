{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "deploy",
        "promote",
        "rollback",
        "restart",
        "stop",
        "uninstall",
        "purge"
      ]
    },
    "target": {
      "$ref": "https://schemas.wanx.example/deployment/v1/common.schema.json#/definitions/target"
    },
    "releaseRef": {
      "$ref": "https://schemas.wanx.example/deployment/v1/common.schema.json#/definitions/releaseRef"
    },
    "expectedGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "idempotencyKey": {
      "$ref": "https://schemas.wanx.example/deployment/v1/common.schema.json#/definitions/id"
    },
    "decisionRef": {
      "$ref": "https://schemas.wanx.example/deployment/v1/common.schema.json#/definitions/reference"
    },
    "validationRef": {
      "$ref": "https://schemas.wanx.example/deployment/v1/common.schema.json#/definitions/reference"
    },
    "regressionRef": {
      "$ref": "https://schemas.wanx.example/deployment/v1/common.schema.json#/definitions/reference"
    },
    "bindingSetRef": {
      "$ref": "https://schemas.wanx.example/deployment/v1/common.schema.json#/definitions/reference"
    },
    "channelBindingsRef": {
      "$ref": "https://schemas.wanx.example/deployment/v1/common.schema.json#/definitions/reference"
    },
    "dataPlanRef": {
      "$ref": "https://schemas.wanx.example/deployment/v1/common.schema.json#/definitions/reference"
    },
    "purgeConfirmationRef": {
      "$ref": "https://schemas.wanx.example/deployment/v1/common.schema.json#/definitions/reference"
    },
    "retryOf": {
      "$ref": "https://schemas.wanx.example/deployment/v1/common.schema.json#/definitions/id"
    },
    "supersedes": {
      "$ref": "https://schemas.wanx.example/deployment/v1/common.schema.json#/definitions/id"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "target",
    "expectedGeneration",
    "idempotencyKey",
    "decisionRef"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.wanx.example/deployment/v1/request.schema.json",
  "title": "Public DeploymentRequest v1 draft",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "deploy",
              "promote",
              "rollback"
            ]
          }
        },
        "type": "object"
      },
      "then": {
        "required": [
          "releaseRef",
          "validationRef",
          "bindingSetRef",
          "channelBindingsRef",
          "dataPlanRef"
        ],
        "properties": {
          "releaseRef": {},
          "validationRef": {},
          "bindingSetRef": {},
          "channelBindingsRef": {},
          "dataPlanRef": {}
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "deploy",
              "promote",
              "rollback"
            ]
          },
          "target": {
            "properties": {
              "environment": {
                "const": "prod"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "required": [
          "regressionRef"
        ],
        "properties": {
          "regressionRef": {}
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "promote"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "environment": {
                "const": "prod"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "purge"
          }
        },
        "type": "object"
      },
      "then": {
        "required": [
          "purgeConfirmationRef"
        ],
        "properties": {
          "purgeConfirmationRef": {}
        },
        "type": "object"
      },
      "else": {
        "not": {
          "required": [
            "purgeConfirmationRef"
          ],
          "properties": {
            "purgeConfirmationRef": {}
          },
          "type": "object"
        }
      }
    }
  ]
}
