{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:wanx:expert-backend:v1",
  "title": "WANX expert application backend v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "template", "mode"],
  "properties": {
    "schemaVersion": {"const": 1},
    "format": {"const": "wanx-expert-backend-v1"},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 65536},
    "mode": {"const": "ask"},
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "version", "digest"],
      "properties": {
        "resourceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "version": {"type": "string", "pattern": "^0\\.0\\.0\\+sha\\.[a-f0-9]{12}$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
